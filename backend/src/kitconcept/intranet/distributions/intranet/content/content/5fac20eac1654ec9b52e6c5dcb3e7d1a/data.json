            {
              "contentRich": [
                {
                  "children": [
                    {
                      "text": "Bitte die Frist auf zehn Arbeitstage anheben \u2014 die Reisestelle braucht bei Auslandsbuchungen deutlich mehr Vorlauf."
                    }
                  ],
                  "id": "5AqQD8U5UY",
                  "type": "p"
                }
              ],
              "createdAt": "2026-07-29T13:37:45.233Z",
              "discussionId": "o6Yj1Kg09bGG-HQBS82Kj",
              "id": "hkIHYyu5fFMfZwKlz_gbP",
