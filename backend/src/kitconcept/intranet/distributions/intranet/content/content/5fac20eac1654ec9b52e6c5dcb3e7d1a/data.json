              "userId": "m.engelhardt"
            },
            {
              "contentRich": [
                {
                  "children": [
                    {
                      "text": "Guter Punkt, ich passe den Absatz bis heute Abend an."
                    }
                  ],
                  "id": "BHT-EtEYwE",
                  "type": "p"
                }
              ],
              "createdAt": "2026-07-29T13:54:53.754Z",
              "discussionId": "o6Yj1Kg09bGG-HQBS82Kj",
