<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    >
  <browser:page
      name="delete_confirmation_info"
      for="plone.dexterity.interfaces.IDexterityContent"
      class=".linkintegrity.TaskAwareDeleteConfirmationInfo"
      permission="zope2.Public"
      />
  <adapter
      factory=".model.task_uuid"
      provides="plone.uuid.interfaces.IUUID"
      for=".model.IInlineTask"
      />
  <adapter
      factory="plone.indexer.wrapper.IndexableObjectWrapper"
      provides="plone.indexer.interfaces.IIndexableObject"
      for=".model.IInlineTask
           plone.base.interfaces.IPloneCatalogTool"
      />
  <adapter
      factory=".model.TaskNamespace"
      provides="zope.traversing.interfaces.ITraversable"
      for="plone.dexterity.interfaces.IDexterityContent"
      name="tasks"
      />
  <adapter
      factory=".model.TaskNamespace"
      provides="zope.traversing.interfaces.ITraversable"
      for="plone.dexterity.interfaces.IDexterityContent
           zope.publisher.interfaces.browser.IBrowserRequest"
      name="tasks"
      />
  <subscriber
      for="plone.dexterity.interfaces.IDexterityContent
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".subscribers.modified"
      />
  <subscriber
      for="plone.dexterity.interfaces.IDexterityContent
           OFS.interfaces.IObjectWillBeMovedEvent"
      handler=".subscribers.will_move"
      />
  <subscriber
      for="plone.dexterity.interfaces.IDexterityContent
           zope.lifecycleevent.interfaces.IObjectMovedEvent"
      handler=".subscribers.moved"
      />
  <subscriber
      for="plone.dexterity.interfaces.IDexterityContent
           zope.lifecycleevent.interfaces.IObjectCopiedEvent"
      handler=".subscribers.copied"
      />
</configure>
