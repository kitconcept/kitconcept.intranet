        },
        {
          "children": [
            {
              "text": "10:00 Uhr \u2013 Wiederholung und Fragen"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "10:30 Uhr \u2013 Anwendungen: Quantengravimetrie und Inertialsensorik"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "12:00 Uhr \u2013 Mittagspause"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "13:00 Uhr \u2013 Gastvortrag: Quantensensoren in der klinischen Bildgebung (MEG)"
            }
          ],
