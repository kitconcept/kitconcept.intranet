<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:cache="http://namespaces.zope.org/cache"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    >

  <!-- Override /@types service to conditionally hide some behaviors -->
  <plone:service
      method="GET"
      factory=".types.TypesGet"
      for="zope.interface.Interface"
      permission="zope2.View"
      name="@types"
      />

  <!-- @site serves public bootstrap data only and must stay reachable for
       anonymous users even when the restricted workflow removes View from
       the site root (e.g. so volto-solr can detect collective.solr.active
       before login). Re-registers the service from plone.restapi (which uses
       zope2.View) on our browser layer with a public permission. -->
  <plone:service
      method="GET"
      factory="plone.restapi.services.site.get.SiteGet"
      for="plone.restapi.bbb.IPloneSiteRoot"
      permission="zope.Public"
      layer="kitconcept.intranet.interfaces.IBrowserLayer"
      name="@site"
      />

  <!-- collective.taxonomy guards the @taxonomy write endpoints with
       cmf.ManagePortal, which Plone grants to Manager only. Re-register them
       on our browser layer with the "Manage taxonomies" permission, which
       Site Administrators have, as the taxonomy control panel itself uses. -->
  <plone:service
      method="POST"
      factory="collective.taxonomy.restapi.services.taxonomy.add.TaxonomyPost"
      for="plone.base.interfaces.IPloneSiteRoot"
      permission="collective.taxonomy.ManageTaxonomies"
      layer="kitconcept.intranet.interfaces.IBrowserLayer"
      name="@taxonomy"
      />

  <plone:service
      method="PATCH"
      factory="collective.taxonomy.restapi.services.taxonomy.update.TaxonomyPatch"
      for="plone.base.interfaces.IPloneSiteRoot"
      permission="collective.taxonomy.ManageTaxonomies"
      layer="kitconcept.intranet.interfaces.IBrowserLayer"
      name="@taxonomy"
      />

  <plone:service
      method="DELETE"
      factory="collective.taxonomy.restapi.services.taxonomy.delete.TaxonomyDelete"
      for="plone.base.interfaces.IPloneSiteRoot"
      permission="collective.taxonomy.ManageTaxonomies"
      layer="kitconcept.intranet.interfaces.IBrowserLayer"
      name="@taxonomy"
      />

  <adapter
      factory=".byline.BylineExpander"
      name="byline"
      />

  <adapter
      factory=".clm.CLMExpander"
      name="clm"
      />

  <plone:service
      method="GET"
      factory=".byline.BylineGet"
      for="zope.interface.Interface"
      permission="zope2.View"
      name="@byline"
      />

  <plone:service
      method="GET"
      factory=".clm.CLMGet"
      for="zope.interface.Interface"
      permission="zope2.View"
      name="@clm"
      />

  <plone:service
      method="POST"
      factory=".feedback_contact_form.FeedbackPostContactForm"
      for="zope.interface.Interface"
      permission="zope2.View"
      name="@contact-form-feedback"
      />

  <cache:ruleset
      for=".byline.BylineGet"
      ruleset="plone.content.dynamic"
      />

  <plone:service
      method="POST"
      factory=".votes.VotesPost"
      for="zope.interface.Interface"
      permission="zope2.View"
      name="@vote"
      />

  <adapter
      factory=".watch.WatchExpander"
      name="watch"
      />

  <plone:service
      method="GET"
      factory=".watch.WatchGet"
      for="kitconcept.intranet.behaviors.watchers.IWatchable"
      permission="zope2.View"
      name="@watch"
      />

  <plone:service
      method="POST"
      factory=".watch.WatchPost"
      for="kitconcept.intranet.behaviors.watchers.IWatchable"
      permission="zope2.View"
      name="@watch"
      />

  <plone:service
      method="POST"
      factory=".review.ReviewPost"
      for="kitconcept.intranet.behaviors.content_review.IContentReview"
      permission="cmf.ModifyPortalContent"
      name="@review"
      />

  <plone:service
      method="GET"
      factory=".type_workflow.TypeWorkflowGet"
      for="plone.restapi.bbb.IPloneSiteRoot"
      permission="plone.app.controlpanel.Types"
      name="@type-workflow"
      />

  <plone:service
      method="PATCH"
      factory=".type_workflow.TypeWorkflowPatch"
      for="plone.restapi.bbb.IPloneSiteRoot"
      permission="plone.app.controlpanel.Types"
      name="@type-workflow"
      />

</configure>
