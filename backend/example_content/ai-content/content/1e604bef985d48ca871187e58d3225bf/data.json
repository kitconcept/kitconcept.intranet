    "slate-intro": {
      "@type": "slate",
      "theme": "default",
      "value": [
        {
          "children": [
            {
              "text": "Die Jahrestagung Systemforschung 2026 pr\u00e4sentiert Ergebnisse aus dem Bereich komplexer Systeme \u2013 von soziotechnischen Systemen \u00fcber biologische Netzwerke bis hin zu Klimamodellen. Die Tagung f\u00f6rdert den Austausch zwischen den DFNT-Instituten und l\u00e4dt externe Forschende aus dem Helmholtz- und Leibniz-Verbund ein."
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Tagungsort: DFNT Hauptcampus Berlin, Geb\u00e4ude B (Konferenzzentrum). Externe Teilnahme auf Anmeldung m\u00f6glich."
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Agenda \u2013 Tag 1 (7. Mai)"
            }
          ],
          "type": "h2"
        },
        {
          "children": [
            {
              "text": "09:00 Uhr \u2013 Registrierung"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "09:30 Uhr \u2013 Er\u00f6ffnungsvortrag: Systemforschung am DFNT \u2013 Status und Ausblick"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "10:30 Uhr \u2013 Kaffeepause"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "11:00 Uhr \u2013 Vortragsblock I: Komplexe Systeme in Biologie und Medizin (3 \u00d7 20 Min.)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "13:00 Uhr \u2013 Mittagspause"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "14:00 Uhr \u2013 Vortragsblock II: Soziotechnische Systeme und Nachhaltigkeit (2 \u00d7 20 Min.)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "15:00 Uhr \u2013 Poster-Session und Kaffee"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "17:00 Uhr \u2013 Tagungsabend (Restaurant im Wissenschaftspark)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Agenda \u2013 Tag 2 (8. Mai)"
            }
          ],
          "type": "h2"
        },
        {
          "children": [
            {
              "text": "09:00 Uhr \u2013 Keynote: Simulationsbasierte Systemanalyse (externer Gastredner)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "10:30 Uhr \u2013 Kaffeepause"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "11:00 Uhr \u2013 Parallele Workshops: Netzwerkanalyse / Systemmodellierung"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "13:00 Uhr \u2013 Mittagspause"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "14:00 Uhr \u2013 Nachwuchsvort\u00e4ge und Best-Paper-Award"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "15:30 Uhr \u2013 Abschlussdiskussion und n\u00e4chste Schritte"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Anmeldung"
            }
          ],
          "type": "h2"
        },
        {
          "children": [
            {
              "text": "Abstract-Einreichung bis 1. M\u00e4rz 2026. Anmeldung \u00fcber das Tagungsportal."
            }
          ],
          "type": "p"
        }
      ]
    }
