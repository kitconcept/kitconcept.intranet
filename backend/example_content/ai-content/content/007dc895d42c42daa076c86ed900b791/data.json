    "slate-intro": {
      "@type": "slate",
      "theme": "default",
      "value": [
        {
          "children": [
            {
              "text": "Der Institutions\u00fcbergreifende Netzwerktag 2026 vernetzt das DFNT mit Partnerhochschulen, Helmholtz-Zentren, Leibniz-Instituten und Industriepartnern. Ziel ist es, bestehende Kooperationen zu vertiefen und neue Verbundprojekte anzusto\u00dfen \u2013 von gemeinsamen F\u00f6rderantr\u00e4gen bis zu Nachwuchsaustauschprogrammen."
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Teilnahme auf Einladung und nach Anmeldung bis 30. April 2026 (netzwerk@dfnt.de)."
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Agenda (14. Mai 2026)"
            }
          ],
          "type": "h2"
        },
        {
          "children": [
            {
              "text": "09:00 Uhr \u2013 Registrierung und Kaffee"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "09:30 Uhr \u2013 Begr\u00fc\u00dfung DFNT und Partnerinstitutionen"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "10:00 Uhr \u2013 Kurzpr\u00e4sentationen der Partnereinrichtungen (je 7 Min.)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "11:30 Uhr \u2013 Kaffeepause"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "11:45 Uhr \u2013 Speed-Networking: 10 \u00d7 5-Minuten-Gespr\u00e4che (organisiert)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "13:00 Uhr \u2013 Mittagspause und informelles Networking"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "14:00 Uhr \u2013 Workshop A: Gemeinsame F\u00f6rderantr\u00e4ge (DFG, EU Horizon)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "14:00 Uhr \u2013 Workshop B: Geteilte Forschungsinfrastruktur"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "14:00 Uhr \u2013 Workshop C: Nachwuchsaustausch und Doppelbetreuung"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "16:00 Uhr \u2013 Ergebnisse und n\u00e4chste Schritte aus den Workshops"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "16:30 Uhr \u2013 Abschluss und Get-Together"
            }
          ],
          "type": "p"
        }
      ]
    }
  },
