    "slate-main-8": {
      "@type": "slate",
      "value": [
        {
          "children": [
            {
              "text": "Proteomics-Tagung 2024"
            }
          ],
          "type": "h2"
        },
        {
          "children": [
            {
              "text": "Die Proteomics-Tagung 2024 versammelte Expertinnen und Experten aus Massenspektrometrie, Bioinformatik und Zellbiologie, um aktuelle Fortschritte in der Proteomforschung zu diskutieren. Im Fokus standen neue Methoden der Einzelzell-Proteomik, Phosphoproteomik und die Integration von Proteom- und Genomdaten."
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Diese Tagung hat bereits stattgefunden. Pr\u00e4sentationen und ausgew\u00e4hlte Poster sind im DFNT-Sharepoint verf\u00fcgbar."
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "R\u00fcckblick: Programmhighlights"
            }
          ],
          "type": "h2"
        },
        {
          "children": [
            {
              "text": "Tag 1 \u2013 12. September 2024"
            }
          ],
          "type": "h3"
        },
        {
          "children": [
            {
              "text": "09:30 Uhr \u2013 Er\u00f6ffnung und Begr\u00fc\u00dfung"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "10:00 Uhr \u2013 Keynote: \u201eSingle-Cell Proteomics: Challenges and Opportunities\u201c (externer Gastredner)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "11:00 Uhr \u2013 Methodensession: Data-Independent Acquisition (DIA) vs. DDA"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "12:30 Uhr \u2013 Mittagspause und Poster-Session"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "14:00 Uhr \u2013 Workshop: Bioinformatik-Tools f\u00fcr Proteomik-Daten (MaxQuant, Perseus)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "16:00 Uhr \u2013 Kurzvortrag-Session: Nachwuchsforschende"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Tag 2 \u2013 13. September 2024"
            }
          ],
          "type": "h3"
        },
        {
          "children": [
            {
              "text": "09:00 Uhr \u2013 Keynote: Phosphoproteomik in der Signalwegforschung"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "10:30 Uhr \u2013 Session: Multi-Omics-Datenintegration"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "12:00 Uhr \u2013 Mittagspause"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "13:00 Uhr \u2013 Abschlussdiskussion und Best Poster Award"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "14:30 Uhr \u2013 Ende"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Materialien"
            }
          ],
          "type": "h2"
        },
        {
          "children": [
            {
              "text": "Folien und Poster im DFNT-Intranet unter Forschung \u2192 Veranstaltungsarchiv \u2192 Proteomics 2024."
            }
          ],
          "type": "p"
        }
      ]
    }
