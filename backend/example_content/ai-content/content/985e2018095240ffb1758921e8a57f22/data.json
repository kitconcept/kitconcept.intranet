    "slate-main-7": {
      "@type": "slate",
      "value": [
        {
          "children": [
            {
              "text": "Life Sciences Forschungstag 2026"
            }
          ],
          "type": "h2"
        },
        {
          "children": [
            {
              "text": "Der Life Sciences Forschungstag pr\u00e4sentiert aktuelle Ergebnisse aus den biologischen und medizinischen Forschungsbereichen des DFNT. Er schafft eine Plattform f\u00fcr interdisziplin\u00e4ren Austausch und st\u00e4rkt die Vernetzung zwischen Molekularbiologie, Neurowissenschaften, \u00d6kologie und Klinischer Forschung."
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Die Veranstaltung richtet sich an alle DFNT-Mitarbeitenden sowie Studierende und G\u00e4ste aus Partnereinrichtungen. Postereinreichungen sind bis 30. April m\u00f6glich."
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Agenda"
            }
          ],
          "type": "h2"
        },
        {
          "children": [
            {
              "text": "09:00 Uhr \u2013 Registrierung und Kaffee"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "09:30 Uhr \u2013 Er\u00f6ffnungsvortrag: \u201eLife Sciences am DFNT \u2013 Strategie 2030\u201c"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "10:15 Uhr \u2013 Vortragsblock Molekularbiologie (3 \u00d7 15 Min.)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "11:30 Uhr \u2013 Kaffeepause und Poster-Session (Teil 1)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "12:30 Uhr \u2013 Mittagspause"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "13:30 Uhr \u2013 Vortragsblock Neurowissenschaften (3 \u00d7 15 Min.)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "14:45 Uhr \u2013 Kaffeepause und Poster-Session (Teil 2)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "15:30 Uhr \u2013 Vortragsblock \u00d6kologie und Systembiologie (2 \u00d7 15 Min.)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "16:15 Uhr \u2013 Nachwuchs-Blitzvortr\u00e4ge (5 \u00d7 5 Min.)"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "17:00 Uhr \u2013 Best Poster Award und Abschluss"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "17:30 Uhr \u2013 Networking-Get-Together"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Anmeldung"
            }
          ],
          "type": "h2"
        },
        {
          "children": [
            {
              "text": "Anmeldung bis 15. Mai 2026. Abstract-Einreichungen f\u00fcr Poster und Vortr\u00e4ge bis 30. April."
            }
          ],
          "type": "p"
        }
      ]
    }
