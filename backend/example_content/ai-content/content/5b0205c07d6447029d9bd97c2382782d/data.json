    "9bd3d3ab-dc3b-48dd-824d-ab21d46b03df": {
      "@type": "slate",
      "plaintext": "Verwalten Sie Ihre Newsletter-Abonnements ganz einfach:",
      "theme": "default",
      "value": [
        {
          "children": [
            {
              "text": "Verwalten Sie Ihre Newsletter-Abonnements ganz einfach:"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "An- und Abmeldung per E-Mail: Senden Sie eine E-Mail an "
                    },
                    {
                      "children": [
                        {
                          "text": "newsletter@dfnt.de"
                        }
                      ],
                      "data": {
                        "url": "mailto:newsletter@dfnt.de"
                      },
                      "type": "link"
                    },
                    {
                      "text": " mit dem Betreff \"An-\" oder \"Abmeldung\" zusammen mit Ihrer Mitarbeitendennummer oder E-Mail-Adresse."
                    }
                  ],
                  "type": "p"
                }
              ],
              "type": "li"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "Verwaltung im Mitarbeiterportal: Melden Sie sich im Mitarbeiterportal an und gehen Sie zu \"Mein Profil\" \u2192 \"Newsletter\", um Ihre Abonnementpr\u00e4ferenzen anzupassen."
                    }
                  ],
                  "type": "p"
                }
              ],
              "type": "li"
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "text": "DSGVO-konform: Alle Ihre Daten werden nach den Datenschutzbestimmungen der DSGVO verarbeitet. Sie k\u00f6nnen jederzeit Ihre Abonnements \u00e4ndern oder l\u00f6schen."
                    }
                  ],
                  "type": "p"
                }
              ],
              "type": "li"
            }
          ],
          "type": "ul"
        }
      ]
    }
  },
