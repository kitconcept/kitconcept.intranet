<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    i18n_domain="kitconcept.intranet"
    >

  <configure zcml:condition="installed AccessControl.security">

    <permission
        id="kitconcept.intranet.siteadminsonly"
        title="kitconcept.intranet: Site Admins Only"
        />

    <!-- Who may use the AI assistant (services/ai_edit.py). The assistant reads
         and writes no content, so this only gates the LLM. -->
    <permission
        id="kitconcept.intranet.UseAIEdit"
        title="kitconcept.intranet: Use AI editing"
        />

  </configure>

</configure>
