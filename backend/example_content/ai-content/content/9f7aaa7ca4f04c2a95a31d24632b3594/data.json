    "4c6cfb70-0314-4c8e-984d-88ce6eb5fa79": {
      "@type": "slate",
      "plaintext": "Reisekostenerstattung nach Buchung\n\nNach Ihrer Reise m\u00fcssen Sie die Quittungen innerhalb von 4 Wochen eingereichen. Buchen Sie \u00fcber die offiziellen Portale, um automatische Kostenerfassung zu erm\u00f6glichen. Abweichungen von den Vorgaben erfordern eine separate Genehmigung und f\u00fchren zu Bearbeitungsverz\u00f6gerungen.",
      "theme": "default",
      "value": [
        {
          "children": [
            {
              "text": "Reisekostenerstattung nach Buchung"
            }
          ],
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Nach Ihrer Reise m\u00fcssen Sie die Quittungen innerhalb von 4 Wochen eingereichen. Buchen Sie \u00fcber die offiziellen Portale, um automatische Kostenerfassung zu erm\u00f6glichen. Abweichungen von den Vorgaben erfordern eine separate Genehmigung und f\u00fchren zu Bearbeitungsverz\u00f6gerungen."
            }
          ],
          "type": "p"
        }
      ]
    },
    "690782d8-36c6-44ea-b7c4-377c868c0637": {
      "@type": "slate",
      "plaintext": "Das DFNT arbeitet mit zertifizierten Reisepartnern zusammen, um sichere und kosteneffiziente Buchungen zu erm\u00f6glichen. Alle Portale sind \u00fcber Single Sign-On (SSO) mit Ihren DFNT-Zugangsdaten erreichbar.",
      "theme": "default",
      "value": [
        {
          "children": [
            {
              "text": "Das DFNT arbeitet mit zertifizierten Reisepartnern zusammen, um sichere und kosteneffiziente Buchungen zu erm\u00f6glichen. Alle Portale sind \u00fcber Single Sign-On (SSO) mit Ihren DFNT-Zugangsdaten erreichbar."
            }
          ],
          "type": "p"
        }
      ]
    },
