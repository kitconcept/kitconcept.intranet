    "381e5baa-5f99-47f1-a8f3-f31c1cc7aed9": {
      "@type": "slate",
      "plaintext": "Hey everyone, welcome to the official page for Horizon Summit 2027! This is a one-day event that is organized by Nimbus Labs and it is going to take place on March 18, 2027 at the Riverton Convention Hall. The summit is for people who work in product, design and engineering and who want to learn about what is coming next in the industry. There will be talks, workshops and a lot of chances to meet other people who do similar work. Last year's summit on March 19, 2026 had more than 400 attendees and we are expecting even more people this year. Registration is open now and it closes one week before the event, on March 11, so make sure you sign up soon. Early-bird pricing is available until January 31, 2027.",
      "styles": {},
      "theme": "default",
      "value": [
        {
          "children": [
            {
              "text": "Hey everyone, welcome to the official page for Horizon Summit 2027! This is a one-day event that is organized by Nimbus Labs and it is going to take place on March 18, 2027 at the Riverton Convention Hall. The summit is for people who work in product, design and engineering and who want to learn about what is coming next in the industry. There will be talks, workshops and a lot of chances to meet other people who do similar work. Last year's summit on March 19, 2026 had more than 400 attendees and we are expecting even more people this year. Registration is open now and it closes one week before the event, on March 11, so make sure you sign up soon. Early-bird pricing is available until January 31, 2027."
            }
          ],
          "type": "p"
        }
      ]
    },
