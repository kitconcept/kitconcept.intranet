    "d2bafa3e-cac3-419a-8db0-ca240a8382ca": {
      "@type": "slate",
      "plaintext": "Single Sign-On (SSO) Anmeldung\n\n1. Navigieren Sie zum jeweiligen Portal (HRS / Lufthansa / Bahn)\n2. Klicken Sie auf 'DFNT Login' oder 'Single Sign-On'\n3. Verwenden Sie Ihre DFNT-Zugangsdaten (E-Mail: vorname.nachname@dfnt.de)\n4. Bei Problemen: IT-Support unter support@dfnt.de oder 0221-470-5700",
      "theme": "default",
      "value": [
        {
          "children": [
            {
              "text": "Single Sign-On (SSO) Anmeldung"
            }
          ],
          "type": "p"
