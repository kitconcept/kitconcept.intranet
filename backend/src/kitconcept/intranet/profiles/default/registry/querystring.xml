  <!-- Current User operation (generic for any Person reference field) -->
  <records interface="plone.app.querystring.interfaces.IQueryOperation"
           prefix="plone.app.querystring.operation.selection.currentUser"
  >
    <value key="title"
           i18n:translate="label_current_user_filter"
    >Current logged in user</value>
    <value key="description"
           i18n:translate="help_current_user_filter"
    >Matches the value(s) assigned to the currently logged-in user</value>
    <value key="operation">kitconcept.intranet.queryparser._currentUser</value>
    <value key="widget" />
  </records>

